{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zaka-plus",
  "main": "worker.js",
  "compatibility_date": "2025-04-08",
  "ai": {
    "binding": "AI"
  },
  "previews": {
    "ai": {
      "binding": "AI"
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}

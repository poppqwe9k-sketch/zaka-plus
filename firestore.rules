rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'poppqwe9k@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isNotBanned(userData) {
      return !('banned' in userData) || userData.banned != true;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'plan',
          'dailyLimit',
          'remainingCredits',
          'cycleStartedAt',
          'lastResetDate',
          'totalUsed',
          'visitsCount',
          'createdAt',
          'updatedAt',
          'lastActiveAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'plan',
          'dailyLimit',
          'remainingCredits',
          'cycleStartedAt',
          'lastResetDate',
          'hydrogenUsedCount',
          'hydrogenQuotaDate',
          'totalUsed',
          'visitsCount',
          'createdAt',
          'updatedAt',
          'lastActiveAt',
          'banned'
        ])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.plan in ['free', 'pro', 'vip']
        && data.dailyLimit is int && data.dailyLimit >= 1 && data.dailyLimit <= 10000
        && data.remainingCredits is int && data.remainingCredits >= 0 && data.remainingCredits <= 100000
        && data.cycleStartedAt is int && data.cycleStartedAt >= 0
        && data.lastResetDate is string && data.lastResetDate.size() >= 8 && data.lastResetDate.size() <= 20
        && (!('hydrogenUsedCount' in data) || (data.hydrogenUsedCount is int && data.hydrogenUsedCount >= 0 && data.hydrogenUsedCount <= 100000))
        && (!('hydrogenQuotaDate' in data) || (data.hydrogenQuotaDate is string && data.hydrogenQuotaDate.size() >= 8 && data.hydrogenQuotaDate.size() <= 20))
        && data.totalUsed is int && data.totalUsed >= 0 && data.totalUsed <= 10000000
        && data.visitsCount is int && data.visitsCount >= 0 && data.visitsCount <= 10000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.lastActiveAt is timestamp
        && (!('banned' in data) || data.banned is bool);
    }

    function isValidUserChat(data, uid) {
      return data.keys().hasAll([
          'id',
          'ownerUid',
          'title',
          'messages',
          'createdAtMs',
          'updatedAtMs',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerUid',
          'title',
          'messages',
          'createdAtMs',
          'updatedAtMs',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerUid)
        && data.ownerUid == uid
        && data.ownerUid == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.messages is list && data.messages.size() <= 300
        && (data.messages.size() == 0 || (
          data.messages[0] is map
          && data.messages[0].id is string
          && data.messages[0].id.size() >= 1 && data.messages[0].id.size() <= 128
          && data.messages[0].role in ['user', 'assistant']
        ))
        && data.createdAtMs is int && data.createdAtMs >= 0
        && data.updatedAtMs is int && data.updatedAtMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSiteAnalytics(data) {
      return data.keys().hasAll(['totalVisits', 'registeredUsersCount', 'updatedAt'])
        && data.keys().hasOnly(['totalVisits', 'registeredUsersCount', 'updatedAt'])
        && data.totalVisits is int && data.totalVisits >= 0 && data.totalVisits <= 1000000000
        && data.registeredUsersCount is int && data.registeredUsersCount >= 0 && data.registeredUsersCount <= 100000000
        && data.updatedAt is timestamp;
    }

    function isValidModelQuotaAnalytics(data) {
      return data.keys().hasAll([
          'cycleStartedAt',
          'ptDateKey',
          'plusPlusUsed',
          'plusUsed',
          'plusPlusChars',
          'plusChars',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'cycleStartedAt',
          'ptDateKey',
          'plusPlusUsed',
          'plusUsed',
          'plusPlusChars',
          'plusChars',
          'updatedAt'
        ])
        && data.cycleStartedAt is int && data.cycleStartedAt >= 0
        && data.ptDateKey is string && data.ptDateKey.size() >= 8 && data.ptDateKey.size() <= 16
        && data.plusPlusUsed is int && data.plusPlusUsed >= 0 && data.plusPlusUsed <= 1000000
        && data.plusUsed is int && data.plusUsed >= 0 && data.plusUsed <= 1000000
        && data.plusPlusChars is int && data.plusPlusChars >= 0 && data.plusPlusChars <= 500000000
        && data.plusChars is int && data.plusChars >= 0 && data.plusChars <= 500000000
        && data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow get: if isValidId(uid) && isSignedIn() && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(uid)
        && isSignedIn()
        && isValidUserProfile(incoming())
        && incoming().uid == uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().lastActiveAt == request.time
        && (!('banned' in incoming()) || incoming().banned == false)
        && (!('hydrogenUsedCount' in incoming()) || incoming().hydrogenUsedCount == 0)
        && (!('hydrogenQuotaDate' in incoming()) || (incoming().hydrogenQuotaDate is string && incoming().hydrogenQuotaDate.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')))
        && (
          isAdmin() || (
            isOwner(uid)
            && incoming().plan == 'free'
            && incoming().dailyLimit == 3
            && incoming().remainingCredits == 3
            && incoming().totalUsed == 0
            && incoming().visitsCount == 1
          )
        );

      allow update: if resource != null
        && isValidId(uid)
        && isSignedIn()
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['plan', 'dailyLimit', 'remainingCredits', 'hydrogenUsedCount', 'updatedAt'])
          ) ||
          (isAdmin()
            && !isOwner(uid)
            && existing().email.lower() != 'poppqwe9k@gmail.com'
            && incoming().diff(existing()).affectedKeys().hasOnly(['banned', 'updatedAt'])
            && incoming().banned is bool
          ) ||
          (isOwner(uid)
            && isNotBanned(existing())
            && incoming().plan == existing().plan
            && incoming().dailyLimit == existing().dailyLimit
            && (!('banned' in incoming()) || (('banned' in existing()) ? incoming().banned == existing().banned : incoming().banned == false))
            && (
              // Action 1: Consume 1 credit and increment hydrogenUsedCount after real AI response
              (incoming().diff(existing()).affectedKeys().hasOnly(['remainingCredits', 'totalUsed', 'hydrogenUsedCount', 'hydrogenQuotaDate', 'lastResetDate', 'cycleStartedAt', 'updatedAt', 'lastActiveAt'])
                && incoming().totalUsed == existing().totalUsed + 1
                && incoming().lastActiveAt == request.time
                && incoming().hydrogenUsedCount is int
                && incoming().hydrogenQuotaDate is string
                && incoming().hydrogenQuotaDate.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
                && (
                  (
                    (('hydrogenQuotaDate' in existing()) ? incoming().hydrogenQuotaDate == existing().hydrogenQuotaDate : incoming().lastResetDate == existing().lastResetDate)
                    && incoming().lastResetDate == existing().lastResetDate
                    && incoming().cycleStartedAt == existing().cycleStartedAt
                    && existing().remainingCredits >= 1
                    && incoming().remainingCredits == existing().remainingCredits - 1
                    && (
                      ('hydrogenUsedCount' in existing())
                        ? incoming().hydrogenUsedCount == existing().hydrogenUsedCount + 1
                        : (incoming().hydrogenUsedCount >= 1 && incoming().hydrogenUsedCount <= existing().dailyLimit)
                    )
                  ) ||
                  (
                    (('hydrogenQuotaDate' in existing()) ? incoming().hydrogenQuotaDate != existing().hydrogenQuotaDate : incoming().lastResetDate != existing().lastResetDate)
                    && incoming().lastResetDate == incoming().hydrogenQuotaDate
                    && incoming().lastResetDate != existing().lastResetDate
                    && incoming().hydrogenUsedCount == 1
                    && incoming().cycleStartedAt >= existing().cycleStartedAt
                    && incoming().cycleStartedAt <= request.time.toMillis() + 300000
                    && incoming().remainingCredits == ((existing().remainingCredits > existing().dailyLimit ? existing().remainingCredits : existing().dailyLimit) - 1)
                  )
                )
              ) ||
              // Action 2: Strict 24h cycle renewal back to dailyLimit
              (incoming().diff(existing()).affectedKeys().hasOnly(['remainingCredits', 'cycleStartedAt', 'lastResetDate', 'hydrogenUsedCount', 'hydrogenQuotaDate', 'updatedAt', 'lastActiveAt'])
                && incoming().cycleStartedAt - existing().cycleStartedAt >= 86400000
                && incoming().cycleStartedAt <= request.time.toMillis() + 300000
                && incoming().remainingCredits >= existing().dailyLimit
                && incoming().remainingCredits <= (existing().remainingCredits > existing().dailyLimit ? existing().remainingCredits : existing().dailyLimit)
                && (!('hydrogenUsedCount' in incoming()) || incoming().hydrogenUsedCount == 0)
                && (!('hydrogenQuotaDate' in incoming()) || incoming().hydrogenQuotaDate == incoming().lastResetDate)
                && incoming().lastActiveAt == request.time
              ) ||
              // Action 3: Record session visit & displayName sync
              (incoming().diff(existing()).affectedKeys().hasOnly(['visitsCount', 'lastActiveAt', 'updatedAt', 'displayName'])
                && incoming().visitsCount >= existing().visitsCount
                && incoming().visitsCount <= existing().visitsCount + 1
                && incoming().lastActiveAt == request.time
              ) ||
              // Action 4: Daily YYYY-MM-DD hydrogen quota reset / schema initialization
              (incoming().diff(existing()).affectedKeys().hasOnly(['hydrogenUsedCount', 'hydrogenQuotaDate', 'remainingCredits', 'lastResetDate', 'cycleStartedAt', 'updatedAt', 'lastActiveAt'])
                && incoming().lastActiveAt == request.time
                && incoming().hydrogenQuotaDate is string
                && incoming().hydrogenQuotaDate.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
                && (
                  (
                    incoming().lastResetDate == incoming().hydrogenQuotaDate
                    && incoming().lastResetDate != existing().lastResetDate
                    && (!('hydrogenQuotaDate' in existing()) || incoming().hydrogenQuotaDate != existing().hydrogenQuotaDate)
                    && incoming().hydrogenUsedCount == 0
                    && incoming().cycleStartedAt >= existing().cycleStartedAt
                    && incoming().cycleStartedAt <= request.time.toMillis() + 300000
                    && incoming().remainingCredits >= existing().remainingCredits
                    && incoming().remainingCredits <= (existing().remainingCredits > existing().dailyLimit ? existing().remainingCredits : existing().dailyLimit)
                  ) ||
                  (
                    (!('hydrogenQuotaDate' in existing()) || !('hydrogenUsedCount' in existing()))
                    && incoming().lastResetDate == existing().lastResetDate
                    && incoming().hydrogenQuotaDate == existing().lastResetDate
                    && incoming().cycleStartedAt == existing().cycleStartedAt
                    && incoming().remainingCredits == existing().remainingCredits
                    && incoming().hydrogenUsedCount >= 0
                    && incoming().hydrogenUsedCount <= existing().dailyLimit
                  ) ||
                  (
                    'hydrogenQuotaDate' in existing()
                    && incoming().hydrogenQuotaDate != existing().hydrogenQuotaDate
                    && incoming().lastResetDate == existing().lastResetDate
                    && incoming().hydrogenQuotaDate == existing().lastResetDate
                    && incoming().cycleStartedAt == existing().cycleStartedAt
                    && incoming().remainingCredits == existing().remainingCredits
                    && incoming().hydrogenUsedCount == 0
                  )
                )
              )
            )
          )
        );

      allow delete: if false;

      match /chats/{chatId} {
        allow get: if isValidId(uid)
          && isValidId(chatId)
          && isOwner(uid)
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid
          && isNotBanned(get(/databases/$(database)/documents/users/$(uid)).data);

        allow list: if isValidId(uid)
          && isOwner(uid)
          && existing().ownerUid == request.auth.uid
          && isNotBanned(get(/databases/$(database)/documents/users/$(uid)).data);

        allow create: if isValidId(uid)
          && isValidId(chatId)
          && isOwner(uid)
          && isValidUserChat(incoming(), uid)
          && incoming().id == chatId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid
          && isNotBanned(get(/databases/$(database)/documents/users/$(uid)).data);

        allow update: if isValidId(uid)
          && isValidId(chatId)
          && isOwner(uid)
          && isValidUserChat(incoming(), uid)
          && incoming().id == existing().id
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().createdAtMs == existing().createdAtMs
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'messages', 'updatedAtMs', 'updatedAt'])
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid
          && isNotBanned(get(/databases/$(database)/documents/users/$(uid)).data);

        allow delete: if isValidId(uid)
          && isValidId(chatId)
          && isOwner(uid)
          && get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid
          && isNotBanned(get(/databases/$(database)/documents/users/$(uid)).data);
      }
    }

    match /analytics/{docId} {
      allow get: if isValidId(docId) && isSignedIn() && (
        (docId == 'site' && isAdmin())
        || docId == 'quota'
      );
      allow list: if false;

      allow create: if isValidId(docId)
        && isSignedIn()
        && (
          (docId == 'site'
            && isValidSiteAnalytics(incoming())
            && incoming().totalVisits >= 0 && incoming().totalVisits <= 1
            && incoming().registeredUsersCount >= 0 && incoming().registeredUsersCount <= 1
            && incoming().updatedAt == request.time
          ) ||
          (docId == 'quota'
            && isValidModelQuotaAnalytics(incoming())
            && incoming().cycleStartedAt <= request.time.toMillis() + 300000
            && incoming().plusPlusUsed >= 0 && incoming().plusPlusUsed <= 1
            && incoming().plusUsed >= 0 && incoming().plusUsed <= 1
            && (incoming().plusPlusUsed + incoming().plusUsed) <= 1
            && incoming().plusPlusChars >= 0 && incoming().plusPlusChars <= 200000
            && incoming().plusChars >= 0 && incoming().plusChars <= 200000
            && incoming().updatedAt == request.time
          )
        );

      allow update: if resource != null
        && isValidId(docId)
        && isSignedIn()
        && (
          (docId == 'site'
            && isValidSiteAnalytics(incoming())
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['totalVisits', 'registeredUsersCount', 'updatedAt'])
            && (
              isAdmin() || (
                incoming().totalVisits >= existing().totalVisits
                && incoming().totalVisits <= existing().totalVisits + 1
                && incoming().registeredUsersCount >= existing().registeredUsersCount
                && incoming().registeredUsersCount <= existing().registeredUsersCount + 1
              )
            )
          ) ||
          (docId == 'quota'
            && isValidModelQuotaAnalytics(incoming())
            && incoming().updatedAt == request.time
            && (
              (isAdmin()
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'cycleStartedAt',
                  'ptDateKey',
                  'plusPlusUsed',
                  'plusUsed',
                  'plusPlusChars',
                  'plusChars',
                  'updatedAt'
                ])
              ) ||
              (incoming().diff(existing()).affectedKeys().hasOnly(['plusPlusUsed', 'plusPlusChars', 'updatedAt'])
                && 'ptDateKey' in existing()
                && 'plusPlusChars' in existing()
                && 'plusChars' in existing()
                && request.time.toMillis() - existing().cycleStartedAt < 90000000
                && incoming().cycleStartedAt == existing().cycleStartedAt
                && incoming().ptDateKey == existing().ptDateKey
                && incoming().plusPlusUsed == existing().plusPlusUsed + 1
                && incoming().plusUsed == existing().plusUsed
                && incoming().plusChars == existing().plusChars
                && incoming().plusPlusChars >= existing().plusPlusChars
                && incoming().plusPlusChars <= existing().plusPlusChars + 200000
              ) ||
              (incoming().diff(existing()).affectedKeys().hasOnly(['plusUsed', 'plusChars', 'updatedAt'])
                && 'ptDateKey' in existing()
                && 'plusPlusChars' in existing()
                && 'plusChars' in existing()
                && request.time.toMillis() - existing().cycleStartedAt < 90000000
                && incoming().cycleStartedAt == existing().cycleStartedAt
                && incoming().ptDateKey == existing().ptDateKey
                && incoming().plusUsed == existing().plusUsed + 1
                && incoming().plusPlusUsed == existing().plusPlusUsed
                && incoming().plusPlusChars == existing().plusPlusChars
                && incoming().plusChars >= existing().plusChars
                && incoming().plusChars <= existing().plusChars + 200000
              ) ||
              (incoming().diff(existing()).affectedKeys().hasOnly([
                  'cycleStartedAt',
                  'ptDateKey',
                  'plusPlusUsed',
                  'plusUsed',
                  'plusPlusChars',
                  'plusChars',
                  'updatedAt'
                ])
                && (
                  !('ptDateKey' in existing())
                  || !('plusPlusChars' in existing())
                  || !('plusChars' in existing())
                  || (
                    request.time.toMillis() - existing().cycleStartedAt >= 82800000
                    && incoming().cycleStartedAt - existing().cycleStartedAt >= 82800000
                    && incoming().ptDateKey != existing().ptDateKey
                  )
                )
                && incoming().cycleStartedAt <= request.time.toMillis() + 300000
                && request.time.toMillis() - incoming().cycleStartedAt < 90000000
                && incoming().plusPlusUsed >= 0 && incoming().plusPlusUsed <= 1
                && incoming().plusUsed >= 0 && incoming().plusUsed <= 1
                && (incoming().plusPlusUsed + incoming().plusUsed) <= 1
                && incoming().plusPlusChars >= 0 && incoming().plusPlusChars <= 200000
                && incoming().plusChars >= 0 && incoming().plusChars <= 200000
              )
            )
          )
        );

      allow delete: if false;
    }

    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection' && isSignedIn();
      allow list, write: if false;
    }
  }
}
